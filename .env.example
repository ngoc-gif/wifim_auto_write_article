# ==========================================
# n8n Local Proof of Concept Environment
# ==========================================

# Port binding on localhost
N8N_PORT=5678

# Timezone
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
TZ=Asia/Ho_Chi_Minh

# Host & Protocol for Local Environment
N8N_HOST=localhost
N8N_PROTOCOL=http

# Security: 32+ character random string to encrypt credentials in n8n database
# Generate with: openssl rand -hex 16 or any 32-character random string
N8N_ENCRYPTION_KEY=replace_this_with_your_secure_random_key_min_32_chars
