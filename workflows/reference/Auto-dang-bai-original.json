    {
      "parameters": {
        "jsCode": "'use strict';\n\n// Lấy dữ liệu (ép thành string an toàn)\nconst rawInput = $input.first().json || {};\nlet fullContent = Array.isArray(rawInput.fullContent) ? rawInput.fullContent.join(' ') : String(rawInput.fullContent || '');\nlet title = String(rawInput.title || '');\nlet metaDescription = String(rawInput.metaDescription || '');\n\n// 0. (Tuỳ chọn) xóa thuộc tính style/id\nfullContent = fullContent.replace(/\\s*(?:style|id)=[\"'][^\"']*[\"']/gi, '');\n\n// Helpers\nfunction escapeRegexChar(ch) {\n  return ch.replace(/[-\\/\\\\^$*+?.()|[\\]{}]/g, '\\\\$&');\n}\nfunction normalizeText(str) {\n  return String(str || '').replace(/\\s+/g, ' ').trim();\n}\nfunction stripHTMLTags(html) {\n  return String(html || '').replace(/<[^>]*>/g, '');\n}\n\n// Regex linh hoạt cho title/meta\nfunction createFlexibleRegexChars(text) {\n  if (!text) return null;\n  const parts = [];\n  let i = 0;\n  while (i < text.length) {\n    const ch = text[i];\n    if (/\\s/.test(ch)) {\n      while (i < text.length && /\\s/.test(text[i])) i++;\n      parts.push('(?:\\\\s|<[^>]+>)+');\n    } else {\n      parts.push(escapeRegexChar(ch) + '(?:\\\\s|<[^>]+>)*');\n      i++;\n    }\n  }\n  return new RegExp(parts.join(''), 'is');\n}\n\n// Plain forms để so sánh\nconst plainTitleNorm = normalizeText(stripHTMLTags(title));\nconst plainMetaNorm = normalizeText(stripHTMLTags(metaDescription));\n\n// 1. Tách fullContent thành các block\nconst blockRegex = /<(p|h[1-6]|div|section|article|figure|li|blockquote)[^>]*>[\\s\\S]*?<\\/\\1>/gi;\nlet blocks = [];\nlet lastIndex = 0;\nlet m;\nwhile ((m = blockRegex.exec(fullContent)) !== null) {\n  const idx = m.index;\n  if (idx > lastIndex) {\n    blocks.push({ tag: 'raw', html: fullContent.slice(lastIndex, idx) });\n  }\n  blocks.push({ tag: m[1].toLowerCase(), html: m[0] });\n  lastIndex = blockRegex.lastIndex;\n}\nif (lastIndex < fullContent.length) {\n  blocks.push({ tag: 'raw', html: fullContent.slice(lastIndex) });\n}\n\n// 2. Đánh dấu block cần xóa\nconst removeIdx = new Set();\nfunction blockPlainText(blockHtml) {\n  return normalizeText(stripHTMLTags(blockHtml));\n}\nconst titleRegexFlexible = title ? createFlexibleRegexChars(title) : null;\nconst metaRegexFlexible = metaDescription ? createFlexibleRegexChars(metaDescription) : null;\n\nfor (let i = 0; i < blocks.length; i++) {\n  const b = blocks[i];\n  if (!b || !b.html) continue;\n\n  try {\n    if (title && titleRegexFlexible && titleRegexFlexible.test(b.html)) {\n      removeIdx.add(i);\n      continue;\n    }\n    if (metaDescription && metaRegexFlexible && metaRegexFlexible.test(b.html)) {\n      removeIdx.add(i);\n      continue;\n    }\n  } catch (e) {}\n\n  const plain = blockPlainText(b.html);\n  if (plainTitleNorm && plain.includes(plainTitleNorm)) {\n    removeIdx.add(i);\n    continue;\n  }\n  if (plainMetaNorm && plain.includes(plainMetaNorm)) {\n    removeIdx.add(i);\n    continue;\n  }\n}\n\n// 3. Xóa caption ngay sau ảnh (phiên bản tối ưu)\nconst CAPTION_MAX_LEN = 150;\nfor (let i = 0; i < blocks.length; i++) {\n  if (removeIdx.has(i)) continue;\n  const b = blocks[i];\n  if (!b || !b.html) continue;\n\n  // Chỉ xử lý các block có chứa thẻ <img>\n  if (/<img[^>]*>/i.test(b.html)) {\n    // BƯỚC 3.1: Xử lý caption NẰM TRONG CÙNG BLOCK với ảnh\n    // Tìm nội dung sau thẻ <img> và kiểm tra xem có phải caption không\n    const originalHtml = b.html;\n    const newHtml = originalHtml.replace(/(<img[^>]*>)([\\s\\S]*)/i, (match, imgTag, followingContent) => {\n      const plainFollowing = blockPlainText(followingContent);\n      // Nếu nội dung phía sau có độ dài phù hợp -> coi là caption và loại bỏ\n      if (plainFollowing.length > 0 && plainFollowing.length <= CAPTION_MAX_LEN) {\n        return imgTag; // Chỉ giữ lại thẻ <img>\n      }\n      // Nếu không, giữ lại nội dung gốc\n      return match;\n    });\n    // Cập nhật lại HTML của block nếu có thay đổi\n    blocks[i].html = newHtml;\n\n    // BƯỚC 3.2: Xử lý caption nằm ở block KẾ TIẾP (logic cũ)\n    // Vẫn giữ logic này để xử lý trường hợp caption nằm trong thẻ <p> riêng biệt\n    let j = i + 1;\n    while (j < blocks.length) {\n      if (removeIdx.has(j)) { j++; continue; }\n      const next = blocks[j];\n      if (!next) break;\n      // Bỏ qua các thẻ raw text không có nội dung\n      if (next.tag === 'raw' && blockPlainText(next.html).length === 0) {\n           j++; continue;\n        }\n        // Nếu là thẻ raw có nội dung, dừng lại\n      if (next.tag === 'raw') break;\n\n      const plainNext = blockPlainText(next.html);\n      // Xóa block trống\n      if (plainNext.length === 0) {\n        removeIdx.add(j);\n        j++;\n        continue;\n      }\n      // Xóa block nếu nó là caption (ngắn và không phải heading)\n      if (plainNext.length > 0 && plainNext.length <= CAPTION_MAX_LEN && !/^h[1-6]$/.test(next.tag)) {\n        removeIdx.add(j);\n        j++;\n        continue;\n      }\n      // Dừng lại nếu gặp block không phải caption\n      break;\n    }\n  }\n}\n\n// 4. Rebuild fullContent (không còn title/meta/caption)\nlet newContent = blocks.map((b, idx) => removeIdx.has(idx) ? '' : b.html).join('');\nnewContent = newContent.replace(/\\r?\\n+/g, ' '); // loại bỏ \\n trong fullContent\n\n// 5. Dọn thẻ rỗng\nfunction cleanEmptyTags(content) {\n  let prev;\n  do {\n    prev = content;\n    content = content.replace(/<span[^>]*>\\s*<\\/span>/gi, '');\n    content = content.replace(/<(p|h[1-6]|div|section|article|figure|li|blockquote)[^>]*>(\\s|&nbsp;|<br\\s*\\/?>)*<\\/\\1>/gi, '');\n    content = content.replace(/>\\s+</g, '><');\n  } while (content !== prev);\n  return content;\n}\nnewContent = cleanEmptyTags(newContent).trim();\n\n// 6. Xử lý metaDescription riêng (xóa \\n, normalize spacing)\nconst cleanMetaDescription = metaDescription.replace(/\\r?\\n+/g, ' ').replace(/\\s+/g, ' ').trim();\n\n// Trả về kết quả\nreturn [{\n  title,\n  metaDescription: cleanMetaDescription,\n  bodyContent: newContent\n}];\n"
      },
