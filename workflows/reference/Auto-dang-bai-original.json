    {
      "parameters": {
        "jsCode": "function toSlug(str) {\n  if (!str) return \"\";\n  return str\n    .normalize(\"NFD\") // tách ký tự có dấu\n    .replace(/[\\u0300-\\u036f]/g, \"\") // xóa dấu\n    .toLowerCase() // chuyển thành chữ thường\n    .replace(/đ/g, \"d\") // Thay thế chữ đ thành d\n    .replace(/[^a-z0-9]/g, \"-\") // thay ký tự đặc biệt bằng dấu gạch ngang\n    .trim()\n    .replace(/\\s+/g, \"-\") // thay khoảng trắng bằng dấu \"-\"\n    .replace(/^-+|-+$/g, \"\"); // xóa dấu \"-\" ở đầu/cuối\n}\n\n// Ví dụ input\nconst input = $input.first().json['Từ khóa'];\n\n// Trả ra kết quả\nreturn [\n  {\n    json: {\n      slug: toSlug(input),\n      keyword: input,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        848
      ],
      "id": "824bad50-7327-407f-a21c-ebe9cd76ef9f",
      "name": "Slug"
    },
    {
      "parameters": {
        "jsCode": "// Lấy dữ liệu từ item đầu tiên (sau khi đã gom bằng Aggregate)\nconst item = items[0].json;\n\n// Ép bodyContent về string\nlet bodyContent = Array.isArray(item.bodyContent) \n  ? item.bodyContent.join(\" \") \n  : String(item.bodyContent || \"\");\n\n// Danh sách ảnh mới từ node set image (đã ở dạng <p><img ...></p>)\nconst images = item.image_html || [];\n\n// Regex tìm tất cả thẻ <img ...>\nconst imgRegex = /<img[^>]*>/gi;\n\n// Lấy danh sách ảnh cũ\nconst oldImages = Array.from(bodyContent.matchAll(imgRegex)).map(m => m[0]) || [];\n\n// Thay thế từng ảnh cũ bằng ảnh mới\nlet newContent = bodyContent;\noldImages.forEach((oldImg, index) => {\n  if (images[index]) {\n    newContent = newContent.replace(oldImg, images[index]);\n  }\n});\n\n// Nếu số ảnh mới nhiều hơn ảnh cũ → thêm vào cuối nội dung\nif (images.length > oldImages.length) {\n  for (let i = oldImages.length; i < images.length; i++) {\n    newContent += images[i];\n  }\n}\n\nreturn [{\n  json: {\n    title: item.title ? item.title[0] : \"\",\n    metaDescription: item.metaDescription ? item.metaDescription[0] : \"\",\n    bodyContent: newContent,\n    category: $input.first().json.number[0],\n    slug: $input.first().json.slug[0],\n    thumbnail_id: $input.first().json.thumbnail_id[0],\n    keyword: $input.first().json.keyword[0],\n  }\n}];"
      },
